# Packages
**/packages/**
!packages/
# Imported adapter + signer families. These nest one level deeper than the
# other packages, so the allow-list works per FAMILY. The bare `!packages/<x>/`
# line is load-bearing: git cannot re-include paths under a directory it never
# descended into, so with only the `/**` line `git add -A` stages nothing.
# Re-ignores use `**/` (not `*/`) to reach the second level, e.g.
# packages/para/core/examples/react/dist/.
!packages/adapter/
!packages/adapter/**
packages/adapter/**/dist/
packages/adapter/**/build/
packages/adapter/**/coverage/
packages/adapter/**/node_modules/
!packages/para/
!packages/para/**
packages/para/**/dist/
packages/para/**/build/
packages/para/**/coverage/
packages/para/**/node_modules/
!packages/turnkey/
!packages/turnkey/**
packages/turnkey/**/dist/
packages/turnkey/**/build/
packages/turnkey/**/coverage/
packages/turnkey/**/node_modules/
!packages/react-sdk/
!packages/react-sdk/**
packages/react-sdk/dist/
packages/react-sdk/coverage/
packages/react-sdk/node_modules/
!packages/telemetry-otel/
!packages/telemetry-otel/**
packages/telemetry-otel/dist/
packages/telemetry-otel/coverage/
packages/telemetry-otel/node_modules/
!packages/telemetry-sentry/
!packages/telemetry-sentry/**
packages/telemetry-sentry/dist/
packages/telemetry-sentry/coverage/
packages/telemetry-sentry/node_modules/
!packages/vite-plugin/
!packages/vite-plugin/**
packages/vite-plugin/dist/
packages/vite-plugin/coverage/
packages/vite-plugin/node_modules/
!packages/node-sdk-darwin-arm64/
!packages/node-sdk-darwin-arm64/**
!packages/node-sdk-darwin-x64/
!packages/node-sdk-darwin-x64/**
!packages/node-sdk-linux-x64-gnu/
!packages/node-sdk-linux-x64-gnu/**
# Native binaries are built fresh in CI; never commit them.
packages/node-sdk-*/miden_client_web.node

# Per-package coverage (re-listed to override the package un-ignores above)
crates/web-client/coverage/
crates/idxdb-store/src/coverage/

# Playwright
crates/web-client/test-results
crates/web-client/playwright-report

# TypeScript
*.tsbuildinfo

# JS metadata generated from idxdb-store TypeScript build
crates/idxdb-store/src/js/**/*.d.ts
crates/idxdb-store/src/js/**/*.js.map

# AI tooling
docs/superpowers/

# typedoc output is regenerated fresh by CI on every run via
# `pnpm --filter @miden-sdk/miden-sdk run typedoc`. Don't commit the
# tree — the "Check that web client documentation is up-to-date" step
# in test.yml runs `git diff --exit-code` over this path, which is a
# no-op when the dir is untracked. Treat the step as a warning-only
# smoke test; the canonical API reference is the typedoc output
# rendered on the published docs site.
docs/typedoc/
