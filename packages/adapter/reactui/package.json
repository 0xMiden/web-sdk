{
  "name": "@miden-sdk/miden-wallet-adapter-reactui",
  "version": "0.17.5",
  "description": "React UI Components for connecting Miden-compatible wallets to your dApp.",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "styles.css",
    "AGENTS.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xMiden/web-sdk.git",
    "directory": "packages/adapter/reactui"
  },
  "author": "Miden Contributors",
  "license": "MIT",
  "scripts": {
    "build": "tsc && pnpm run copy-files",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "clean": "rimraf dist/ node_modules/",
    "copy-files": "copyfiles styles.css dist/",
    "doc": "typedoc --disableSources --plugin typedoc-plugin-markdown",
    "test": "vitest run"
  },
  "dependencies": {
    "@miden-sdk/miden-wallet-adapter-base": "workspace:*",
    "@miden-sdk/miden-wallet-adapter-miden": "workspace:*",
    "@miden-sdk/miden-wallet-adapter-react": "workspace:*"
  },
  "devDependencies": {
    "@types/react-dom": "^19.0.4",
    "copyfiles": "^2.4.1",
    "jsdom": "^24.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vitest": "^1.0.0"
  },
  "peerDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "bugs": {
    "url": "https://github.com/0xMiden/web-sdk/issues"
  },
  "homepage": "https://github.com/0xMiden/web-sdk"
}
